# 仲間外れ探し D
# utf-8
A, B = map(int,input().split())
S_1, S_2, S_3 = map(int,input().split())

if S_1 != A+B and S_1 != A-B:
    print(S_1)
elif S_2 != A+B and S_2 != A-B:
    print(S_2)
else:
    print(S_3)
'''
入力は Python では 1 行目も 2 行目も map(int,input().split()) で受け取ることが可能です。
整数 C が A+B, A-B のどちらとも異なるという条件は、and を用いて、C != A+B and C != A-B と表すことが出来るので、if 文を用いて 3 つの要素をそれぞれ判定することで出力が可能です。
'''

# 花の育成 C
# utf-8
T, L, H = map(int,input().split())
ok = 1 # 花が枯れたかどうかのフラグ 0なら枯れてしまっている
now = H # 現在の貯水タンクに入っている水の量を表す変数

# サイクルをT日間繰り返す(for文)
for i in range(T):
    A, B = map(int,input().split())
    # 水を足す処理
    now += A
    if now > L: # 上限以上になったらL mlに直す
        now = L
    # 貯水タンクの水を消費する処理
    if now < B: # 水がB ml未満ならば、花が枯れる
        ok = 0
    now -= B

if ok == 1:
    print("Yes")
else:
    print("No")
'''
for 文を回して、シミュレーションを行いましょう。現在の水の量を表す変数と花が枯れたかどうかを表すフラグを用意します。(実装例ではそれぞれ now, ok です。)
処理は大きく分けて、水を足す処理と水を消費する処理に分けられます。
水を足す処理では、基本的には足し算で処理できますが、持ってきた水の量と、もともと貯水タンクに入っている水の量の和が L mlになってしまった場合、貯水タンクに入っている水の量を L ml にする必要があります。
この処理は、実装例のように if 文を使って処理することができます。また、持ってきた水の量と、もともと貯水タンクに入っている水の量の和と L の小さいほうを min 関数を用いて計算することで行うことも可能です。
貯水タンクの水を消費する処理は、基本的には引き算で処理できますが、もし消費した後がマイナスになるようならば、用意したフラグを用いて花が枯れたことを記録しましょう。
'''

# カラーボム B
# utf-8
def Manhattan(i_1, j_1, i_2, j_2): # マンハッタン距離を計算する関数
    return abs(i_1 - i_2)+abs(j_1 - j_2)

H, W = map(int,input().split())
# 答えを格納する二次元配列の用意 .なら色が塗られてない #なら塗られている
MAP=[]
for i in range(H):
    MAP.append(["."]*W)

for i in range(H):
    S = input()
    for j in range(W):
        if S[j] != ".": # もしカラーボムが置かれているなら
            D = int(S[j])
            # 全てのマスを調べる
            for k in range(H):
                for l in range(W):
                    if Manhattan(i, j, k, l) <= D: # もしマンハッタン距離がD以下なら色を塗る
                        MAP[k][l] = "#"

for i in range(H):
    for j in range(W):
        if j != W-1:
            print(MAP[i][j], end="")
        else:
            print(MAP[i][j])
'''
まずはじめに、答えを格納する二次元配列を用意しましょう。初期値は、最初は全て色が塗られていないので、すべて . です。
カラーボムが置かれているマスが登場するたびに、for 文を使って全てのマスを探索しマンハッタン距離がカラーボムの威力以下である場合には、その都度二次元配列の該当箇所を # に置き換えていきます。実装例 2 のように、カラーボムの威力は最大で 9 なので、範囲を絞って置き換え処理することも可能です。
出力は Python の場合は実装例 1 のように、print 関数を用いて 1 文字ずつ出力するか、実装例 2 のように、join メソッドを用いて一度に出力することで処理が可能です。
'''
